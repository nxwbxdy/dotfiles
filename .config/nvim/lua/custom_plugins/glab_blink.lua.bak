local Job = require "plenary.job"

local source = {}

source.new = function()
  local self = setmetatable({ cache = {} }, { __index = source })
  return self
end

source.complete = function(self, _, callback)
  local bufnr = vim.api.nvim_get_current_buf()

  if not self.cache[bufnr] then
    Job:new({
      "glab",
      "issue",
      "list",
      "--output",
      "json",

      on_exit = function(job)
        local result = job:result()
        local ok, parsed = pcall(vim.json.decode, table.concat(result, ""))
        if not ok then
          vim.notify "Failed to parse glab result"
          return
        end

        local items = {}
        for _, glab_item in ipairs(parsed) do
          glab_item.body = string.gsub(glab_item.body or "", "\r", "")

          table.insert(items, {
            label = string.format("#%s", glab_item.number),
            documentation = {
              kind = "markdown",
              value = string.format("# %s\n\n%s", glab_item.title, glab_item.body),
            },
          })
        end

        callback { items = items, isIncomplete = false }
        self.cache[bufnr] = items
      end,
    })
        :start()
  else
    callback { items = self.cache[bufnr], isIncomplete = false }
  end
end

source.get_trigger_characters = function()
  return { '#' }
end

source.is_available = function ()
  return vim.bo.filetype == "gitcommit"
end

require("blink").register_source("glab_issues", source.new())
