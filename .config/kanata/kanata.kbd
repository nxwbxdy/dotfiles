(defcfg process-unmapped-keys false)
(defvar
  tap-timeout   150
  hold-timeout  150
  tt $tap-timeout
  ht $hold-timeout
  tap-dance-timeout 1000
  td $tap-dance-timeout
)

(defalias
  cw  (caps-word 2000)
)

(defsrc
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  caps  a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft
  lctl lmet lalt           spc            ralt rmet rctl
)

(deflayer devlp
  @grl 1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    @u   i    o    @p   [    ]    \
  @cw  @a   s    d    f    @g   @h   j    k    l    ;    '    ret
  lsft z    x    @c   v    b    n    m    ,    .    /    rsft
  lctl lmet lalt           spc            ralt rmet rctl
)

(deflayer qwerty
  @grl 1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    @cu  i    @co  p    [    ]    \
  @cw  @ca  @cs  d    f    g    h    j    k    l    ;    '    ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft
  lctl lmet lalt           @csp           ralt rmet rctl
)

(defalias
  g (chord git g)
  c (chord git c)
  a (chord git a)
  p (chord git p)
  u (chord git u)
  h (chord git h)
;;  gc (macro g i t spc c o m m i t)
;;  ga (macro g i t spc a d d)
;;  gp (macro g i t spc p u s h)
;;  gu (macro g i t spc p u l l)
)

(defchords git 70
  (g) g
  (h) h
  (c) c
  (a) a
  (p) p
  (u) u
;;  (h c) @gc
;;  (h a) @ga
;;  (g p) @gp
;;  (g u) @gu
)

(defalias
  ca (chord chords a)
  co (chord chords o)
  cu (chord chords u)
  cs (chord chords s)
  csp (chord chords spc)
  uml-a (unicode ä)
  uml-o (unicode ö)
  uml-u (unicode ü)
  uml-s (unicode ß)
)

(defchords chords 100
	   (a) a
	   (o) o
	   (u) u
	   (s) s
	   (spc) spc
	   (spc a) @uml-a
	   (spc o) @uml-o
	   (spc u) @uml-u
	   (spc s) @uml-s
   )


(defalias
  ml	( movemouse-left 3 2 )
  md	( movemouse-down 3 2 )
  mu	( movemouse-up 3 2 )
  mr	( movemouse-right 3 2 )
  mcl	mlft
  mcm	mmid
  mcr	mrgt
  fst	( movemouse-speed 200 )
  slw	( movemouse-speed 50 )
  mwl	( mwheel-left 1 1 )
  mwd	( mwheel-down 1 1 )
  mwu	( mwheel-up 1 1 )
  mwr	( mwheel-right 1 1 )
 )


(deflayer mouse
  @grl _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    @slw @fst _    _    _    _    _    _    _    _    _
  @cw  _    @mcm @mcr @mcl _    @ml  @md  @mu  @mr  _    _    _
  _    _    _    @mwu @mwd _    @mwl @mwr _    _    _    _
  _    _    _              _              _    _    _
)

(deflayer dvorak
  @grl 1    2    3    4    5    6    7    8    9    0    [    ]    bspc
  tab  '    ,    .    p    y    f    g    c    r    l    /    =    \
  _    a    o    e    u    i    d    h    t    n    s    -    ret
  lsft ;    q    j    k    x    b    m    w    v    z    rsft
  lctl lmet lalt           spc            ralt rmet rctl
)

(defalias
  ;; tap: backtick (grave), hold: toggle layer-switching layer while held
  grl (tap-hold $tt $ht grv (layer-toggle layers))

  ;; layer-switch changes the base layer.
  dvk (layer-switch dvorak)
  qwr (layer-switch qwerty)
  ;; qde (layer-switch qwerty_de)
  sql (layer-switch sql_layout)
  ;;ip (layer-switch ip_layout)

  ;; tap for capslk, hold for lctl
  ;; cap (tap-hold $tt $ht caps lctl)
  ms (layer-switch mouse)
  dev (layer-switch devlp)
)



(deflayer layers
  _    @qwr @ms  @dev @dvk _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    @sql _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _              lrld           _    _    _
)

(defalias
	#|sel	(macro S-(s e l e c t))
	frm	(macro S-(f r o m))
	whr	(macro S-(w h e r e))
	lmt	(macro S-(l i m i t))
	grp	(macro S-(g r o u p spc b y))
	on	(macro S-(o n))
	jn	(macro S-(j o i n))
	ordb	(macro S-(o r d e r spc b y))
	hav	(macro S-(h a v i n g))
	ins	(macro S-(i n s e r t spc i n t o))
	val	(macro S-(v a l u e s))
	upd	(macro S-(u p d a t e))
	st	(macro S-(s e t))
	del	(macro S-(d e l e t e spc f r o m))
	ijn	(macro S-(i n n e r spc j o i n))
	ljn	(macro S-(l e f t spc j o i n))
	rjn	(macro S-(r i g h t spc j o i n))
	|#

	#|;; so -> sql o key
	so	(tap-dance-eager $td (
				      @ordb
				      (macro bspc bspc bspc bspc bspc bspc bspc bspc @on) 
				      (macro bspc bspc)
				      ))
	ss	(tap-dance-eager $td (
				      @sel
				      (macro bspc bspc bspc bspc bspc bspc)
				      @st
				      (macro bspc bspc bspc)
				      ))
				      |#
)

(deflayer sql_layout
  @grl _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _              _              _    _    _
)
